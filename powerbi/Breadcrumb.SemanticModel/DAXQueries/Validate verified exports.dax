RETURN ADDCOLUMNS(Checks, "Passed", NOT ISBLANK([Actual]) && ABS([Expected] - [Actual]) <= [Tolerance])
ORDER BY [Check]

// Blank-context guards: all columns below should return TRUE.
EVALUATE
ROW(
    "Multiple modes are blank", ISBLANK([Funnel Reached Sessions]),
    "No assumption is blank", ISBLANK([Modeled Recovery USD]),
    "Product reach total is blank", ISBLANK([Product Viewing Sessions]),
    "Category reach total is blank", ISBLANK([Category Viewing Sessions Full Window]),
    "Terminal loss is blank", ISBLANK(CALCULATE([Funnel Lost Sessions], fct_funnel_daily[funnel_mode] = "any_order", fct_funnel_daily[step_order] = 5)),
    "Empty date context is blank", ISBLANK(CALCULATE([Session Conversion], FILTER(ALL(dim_date), FALSE())))
)
