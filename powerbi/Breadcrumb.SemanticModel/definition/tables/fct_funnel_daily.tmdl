	partition fct_funnel_daily = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "\fct_funnel_daily.csv"),
				        [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"session_start_date", type date},
				        {"device_category", type text},
				        {"country", type text},
				        {"funnel_mode", type text},
				        {"step_order", Int64.Type},
				        {"step_name", type text},
				        {"total_sessions", Int64.Type},
				        {"reached_sessions", Int64.Type},
				        {"purchased_sessions_among_reached", Int64.Type},
				        {"purchase_revenue_usd_among_reached", Currency.Type},
				        {"next_step_reached_sessions", Int64.Type},
				        {"next_step_purchased_sessions", Int64.Type}
				    }, "en-US")
				in
				    Typed
