	partition fct_product_daily = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "\fct_product_daily.csv"),
				        [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"session_start_date", type date},
				        {"device_category", type text},
				        {"country", type text},
				        {"item_id", type text},
				        {"item_category", type text},
				        {"item_name", type text},
				        {"viewing_sessions", Int64.Type},
				        {"purchasing_sessions", Int64.Type},
				        {"view_and_purchase_sessions", Int64.Type},
				        {"purchase_without_view_sessions", Int64.Type},
				        {"null_purchase_item_revenue_rows", Int64.Type},
				        {"purchase_item_revenue_usd", Currency.Type}
				    }, "en-US")
				in
				    Typed
