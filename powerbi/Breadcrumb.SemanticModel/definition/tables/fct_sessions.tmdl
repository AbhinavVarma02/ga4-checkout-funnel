table fct_sessions
	lineageTag: 83ff1b3e-b0fb-526c-a554-633b6dd23554

	measure 'Sessions' =
			COUNTROWS ( fct_sessions )
		formatString: #,0
		displayFolder: Sessions
		lineageTag: b693961c-fc5c-509e-808b-6d628eb10102

	measure 'Purchase Sessions' =
			CALCULATE ( [Sessions], fct_sessions[has_purchase] = TRUE () )
		formatString: #,0
		displayFolder: Sessions
		lineageTag: 6a170be5-d6e7-5a15-9b0e-c9495705b240

	measure 'Session Conversion' =
			DIVIDE ( [Purchase Sessions], [Sessions] )
		formatString: 0.00%
		displayFolder: Sessions
		lineageTag: d86c0eaa-d589-5008-a43c-262fc67c48b0

	measure 'Purchase Revenue USD' =
			SUM ( fct_sessions[purchase_revenue_usd] )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Sessions
		lineageTag: 3ba77191-a1af-500d-aedd-9ed3c6c742e7

	measure 'Purchase Events' =
			SUM ( fct_sessions[purchase_events] )
		formatString: #,0
		displayFolder: Sessions
		lineageTag: 34433a70-2868-577e-8173-f7f74c623bff

	measure 'Revenue per Session USD' =
			DIVIDE ( [Purchase Revenue USD], [Sessions] )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Sessions
		lineageTag: 8204632a-f3a3-5fc2-ba1b-91e0dd85476b

	measure 'Sessions without Observed Start' =
			CALCULATE ( [Sessions], fct_sessions[has_session_start] = FALSE () )
		formatString: #,0
		displayFolder: Sessions
		lineageTag: 200aed1a-c286-549c-82c4-2be067f2c888

	measure 'Funnel Reached Sessions' =
			IF (
			        HASONEVALUE ( fct_funnel_daily[funnel_mode] )
			            && HASONEVALUE ( fct_funnel_daily[step_order] ),
			        SUM ( fct_funnel_daily[reached_sessions] )
			    )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 15687c0e-3cd4-5b0a-b72c-ca5c2e599ee2

	measure 'Funnel Next Step Sessions' =
			IF (
			        HASONEVALUE ( fct_funnel_daily[funnel_mode] )
			            && HASONEVALUE ( fct_funnel_daily[step_order] ),
			        SUM ( fct_funnel_daily[next_step_reached_sessions] )
			    )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 9de9b6cc-2a99-5bc7-bdf1-15f503fa4803

	measure 'Next Step Conversion' =
			DIVIDE ( [Funnel Next Step Sessions], [Funnel Reached Sessions] )
		formatString: 0.00%
		displayFolder: Funnel
		lineageTag: 188b52c9-0e10-541b-8b86-138dab3716aa

	measure 'Funnel Lost Sessions' =
			IF (
			        SELECTEDVALUE ( fct_funnel_daily[step_order] ) < 5
			            && NOT ISBLANK ( [Funnel Reached Sessions] ),
			        [Funnel Reached Sessions] - [Funnel Next Step Sessions]
			    )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 5c5ee35d-553f-51e3-94c0-254c28bbb2f3

	measure 'Entry Sessions Any Order' =
			CALCULATE (
			        SUM ( fct_funnel_daily[reached_sessions] ),
			        REMOVEFILTERS (
			            fct_funnel_daily[funnel_mode],
			            fct_funnel_daily[step_order],
			            fct_funnel_daily[step_name]
			        ),
			        fct_funnel_daily[funnel_mode] = "any_order",
			        fct_funnel_daily[step_order] = 1
			    )
		formatString: #,0
		displayFolder: Assumed opportunity
		lineageTag: c96b0321-c7ec-5766-b8ab-c3bd8d96ca8f

	measure 'View Sessions Any Order' =
			CALCULATE (
			        SUM ( fct_funnel_daily[reached_sessions] ),
			        REMOVEFILTERS (
			            fct_funnel_daily[funnel_mode],
			            fct_funnel_daily[step_order],
			            fct_funnel_daily[step_name]
			        ),
			        fct_funnel_daily[funnel_mode] = "any_order",
			        fct_funnel_daily[step_order] = 2
			    )
		formatString: #,0
		displayFolder: Assumed opportunity
		lineageTag: e6a63524-cce4-52e6-8d9b-2a4e36cc7aad

	measure 'View Continuer Purchase Revenue USD' =
			CALCULATE (
			        SUM ( fct_funnel_daily[purchase_revenue_usd_among_reached] ),
			        REMOVEFILTERS (
			            fct_funnel_daily[funnel_mode],
			            fct_funnel_daily[step_order],
			            fct_funnel_daily[step_name]
			        ),
			        fct_funnel_daily[funnel_mode] = "any_order",
			        fct_funnel_daily[step_order] = 2
			    )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Assumed opportunity
		lineageTag: 5d000198-d435-5780-9dae-8415a31c940d

	measure 'Entry Dropouts Any Order' =
			[Entry Sessions Any Order] - [View Sessions Any Order]
		formatString: #,0
		displayFolder: Assumed opportunity
		lineageTag: 4b399cd7-bca8-5dae-b498-d7932e46f760

	measure 'Assumed Recovery Fraction' =
			SELECTEDVALUE ( recovery_assumption[fraction] )
		formatString: 0.00%
		displayFolder: Assumed opportunity
		lineageTag: cd6822d7-2a5e-5263-abfe-c043979d020c

	measure 'Modeled Recovery USD' =
			VAR Opportunity =
			        [Entry Dropouts Any Order]
			            * DIVIDE ( [View Continuer Purchase Revenue USD], [View Sessions Any Order] )
			    VAR ScenarioValue = Opportunity * [Assumed Recovery Fraction]
			    RETURN
			        IF (
			            NOT ISBLANK ( [Assumed Recovery Fraction] )
			                && [View Sessions Any Order] > 0,
			            ROUNDDOWN ( ScenarioValue * 100, 0 ) / 100
			        )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Assumed opportunity
		lineageTag: 08b8ded2-9578-53a8-b686-c90a37c05dca

	measure 'Item Revenue USD' =
			SUM ( fct_product_daily[purchase_item_revenue_usd] )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Products
		lineageTag: 9404eefd-ec4e-51c9-909c-2340a08648d6

	measure 'Product Viewing Sessions' =
			IF (
			        HASONEVALUE ( fct_product_daily[item_id] )
			            && HASONEVALUE ( fct_product_daily[item_category] ),
			        SUM ( fct_product_daily[viewing_sessions] )
			    )
		formatString: #,0
		displayFolder: Products
		lineageTag: 73c8716a-948b-5a30-a072-efee1edda1cc

	measure 'Product View and Purchase Sessions' =
			IF (
			        HASONEVALUE ( fct_product_daily[item_id] )
			            && HASONEVALUE ( fct_product_daily[item_category] ),
			        SUM ( fct_product_daily[view_and_purchase_sessions] )
			    )
		formatString: #,0
		displayFolder: Products
		lineageTag: f828de89-9cb0-56b3-9e4b-de4cee166534

	measure 'Product Purchase without View Sessions' =
			IF (
			        HASONEVALUE ( fct_product_daily[item_id] )
			            && HASONEVALUE ( fct_product_daily[item_category] ),
			        SUM ( fct_product_daily[purchase_without_view_sessions] )
			    )
		formatString: #,0
		displayFolder: Products
		lineageTag: 1e3d0056-a6aa-518a-b8cd-fc4e2fd033eb

	measure 'Product View to Purchase Conversion' =
			DIVIDE ( [Product View and Purchase Sessions], [Product Viewing Sessions] )
		formatString: 0.00%
		displayFolder: Products
		lineageTag: 62bec922-f0eb-54f7-99f0-0f998088e773

	measure 'Category Viewing Sessions Full Window' =
			IF (
			        HASONEVALUE ( category_summary[item_category] ),
			        SUM ( category_summary[viewing_sessions] )
			    )
		formatString: #,0
		displayFolder: Products
		lineageTag: 1172a2de-a813-5878-b71a-079654d39522

	measure 'Category View and Purchase Sessions Full Window' =
			IF (
			        HASONEVALUE ( category_summary[item_category] ),
			        SUM ( category_summary[view_and_purchase_sessions] )
			    )
		formatString: #,0
		displayFolder: Products
		lineageTag: c1b6ca15-ba15-5f07-9da1-31469c5f95b1

	measure 'Category Conversion Full Window' =
			DIVIDE (
			        [Category View and Purchase Sessions Full Window],
			        [Category Viewing Sessions Full Window]
			    )
		formatString: 0.00%
		displayFolder: Products
		lineageTag: 5f4c96ad-e696-5558-9f52-5c8f439363aa

	measure 'Category Item Revenue USD Full Window' =
			SUM ( category_summary[purchase_item_revenue_usd] )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Products
		lineageTag: 4a312a62-d9e1-5dc7-bd94-047d3c31b80c

	measure 'Next Step Continuer Purchase Revenue USD' =
			VAR CurrentStep = SELECTEDVALUE ( fct_funnel_daily[step_order] )
			    RETURN
			        IF (
			            HASONEVALUE ( fct_funnel_daily[funnel_mode] )
			                && HASONEVALUE ( fct_funnel_daily[step_order] )
			                && CurrentStep < 5,
			            CALCULATE (
			                SUM ( fct_funnel_daily[purchase_revenue_usd_among_reached] ),
			                REMOVEFILTERS ( fct_funnel_daily[step_order], fct_funnel_daily[step_name] ),
			                fct_funnel_daily[step_order] = CurrentStep + 1
			            )
			        )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Funnel
		lineageTag: c4500501-77fb-5981-a9eb-b3f556a3a1dc

	measure 'Modeled Dropoff Opportunity USD' =
			IF (
			        NOT ISBLANK ( [Funnel Lost Sessions] ) && [Funnel Next Step Sessions] > 0,
			        [Funnel Lost Sessions]
			            * DIVIDE ( [Next Step Continuer Purchase Revenue USD], [Funnel Next Step Sessions] )
			    )
		formatString: "$"#,0.00;("$"#,0.00);"$"0.00
		displayFolder: Assumed opportunity
		lineageTag: 0dbd9df0-642e-5e77-a25a-80adfb0c1a88

	measure 'Product Display Name' =
			IF (
			        HASONEVALUE ( fct_product_daily[item_id] )
			            && HASONEVALUE ( fct_product_daily[item_category] ),
			        MAX ( fct_product_daily[item_name] )
			    )
		displayFolder: Products
		lineageTag: d7d4d010-191f-5254-acf1-6950a5dba8e4

