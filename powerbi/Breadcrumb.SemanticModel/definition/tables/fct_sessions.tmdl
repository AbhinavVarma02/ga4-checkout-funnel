		summarizeBy: none
		lineageTag: cba4d20e-73ba-5231-b0dc-33a128fb9c8f

	partition fct_sessions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "\fct_sessions.csv"),
				        [Delimiter=",", Columns=28, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"user_pseudo_id", type text},
				        {"ga_session_id", Int64.Type},
				        {"session_start_date", type date},
				        {"first_event_timestamp_micros", Int64.Type},
				        {"device_category", type text},
				        {"country", type text},
				        {"first_touch_source", type text},
				        {"first_touch_medium", type text},
				        {"event_count", Int64.Type},
				        {"session_start_events", Int64.Type},
				        {"view_item_events", Int64.Type},
				        {"add_to_cart_events", Int64.Type},
				        {"begin_checkout_events", Int64.Type},
				        {"purchase_events", Int64.Type},
				        {"purchase_events_missing_revenue", Int64.Type},
				        {"purchase_revenue_usd", Currency.Type},
				        {"first_touch_channel", type text},
				        {"user_cohort", type text}
				    }, "en-US"),
				    Flags = Table.TransformColumns(Typed, {
				        {"has_session_start", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"has_view_item", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"has_add_to_cart", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"has_begin_checkout", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"has_purchase", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"ordered_session_start", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"ordered_view_item", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"ordered_add_to_cart", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"ordered_begin_checkout", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical},
				        {"ordered_purchase", each if _ = "true" then true else if _ = "false" then false else error "Invalid verified CSV boolean", type logical}
				    }),
				    Labels = Table.AddColumn(Flags, "user_cohort_label", each
				        if [user_cohort] = "new_in_window" then "New in window"
				        else if [user_cohort] = "no_observed_first_visit" then "No observed first_visit"
				        else [user_cohort], type text)
				in
				    Labels
