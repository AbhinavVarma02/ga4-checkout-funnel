# Copy to .env, fill locally, and never commit the filled file.
GCP_PROJECT_ID=your-project-id
BQ_LOCATION=US
# Per-query cap for approved dbt jobs; never overrides billing hard stops.
BQ_MAX_BYTES_BILLED=21474836480
BQ_DATASET_RAW=ga4_raw
BQ_DATASET_ANALYTICS=ga4_analytics
# Optional for manual dbt builds; Airflow sets a unique value per simulated run.
GA4_RUN_LABEL=manual
